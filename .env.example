# ============================================================
# Kitchen ERP — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kitchen_erp?schema=public"

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── API ─────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ── SeaweedFS ───────────────────────────────────────────────
SEAWEEDFS_MASTER_URL="http://localhost:9333"
SEAWEEDFS_PUBLIC_URL="http://localhost:8080"
# Set to "true" to use local filesystem fallback instead of SeaweedFS
SEAWEEDFS_FALLBACK_LOCAL="true"
UPLOADS_DIR="./uploads"

# ── Admin App ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="Kitchen ERP"

# ── PWA ─────────────────────────────────────────────────────
# Same as above — PWA shares environment with admin in monorepo
