# ============================================================
# Kitchen ERP — Root Environment Variables Template
# Copy this file to .env and replace placeholder values.
# ============================================================

# Database (Supabase PostgreSQL Connection Pooling & Direct connection for migrations)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Private Storage (Server-only credentials for API backend)
SUPABASE_URL="https://[YOUR_SUPABASE_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="kitchen-erp-invoices"

# Authentication & Domain
JWT_SECRET="your-secure-jwt-secret-at-least-32-chars"
APP_DOMAIN="kitchenerp.com"

# Multi-Tenant Routing Configuration (path or subdomain)
TENANT_MODE="path"
PWA_BASE_URL="http://localhost:3002"
ADMIN_BASE_URL="http://localhost:3001"
API_BASE_URL="http://localhost:4000"

# ArgusOne Assistant (OpenRouter AI Integration - Free-Only Read-Only BI Assistant)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_ONLY=true
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=ArgusOne
AI_READ_ONLY=true

