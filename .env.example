# ============================================================
# Kitchen ERP — Root Environment Variables Template
# Copy this file to .env and replace placeholder values.
# ============================================================

# Database (Supabase PostgreSQL Connection Pooling & Direct connection for migrations)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication & Domain
JWT_SECRET="your-secure-jwt-secret-at-least-32-chars"
APP_DOMAIN="kitchenerp.com"

# File Storage
SEAWEED_URL="http://localhost:9333"
